# Run manually to reformat a file:
#   clang-format -i --style=file <file>
# Reformat all source files:
#   find src tests benchmark example include -type f \
#     \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \) \
#     -exec clang-format -i --style=file {} +

BasedOnStyle: Google
ColumnLimit: 100
DerivePointerAlignment: false

# Include ordering for RollingRaft project structure:
#   1. System headers (<string>, <vector>, etc.)
#   2. Third-party libraries (<asio.hpp>, <nlohmann/json.hpp>, <gtest/gtest.h>, etc.)
#   3. Project public API ("rollingraft/...")
#   4. Project internal headers and mocks
IncludeCategories:
  - Regex:           '^<[a-z_]+>'
    Priority:        1
    SortPriority:    1
  - Regex:           '^<[^/]*>'
    Priority:        2
    SortPriority:    2
  - Regex:           '^"rollingraft/'
    Priority:        3
    SortPriority:    3
  - Regex:           '.*'
    Priority:        4
    SortPriority:    4
